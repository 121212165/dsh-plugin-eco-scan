node_modules/
package-lock.json

# 扫描报表是运行数据，不随源码发布；只锚定仓库根目录的 reports/，
# 不再匹配任意层级的同名目录（issue #7：data/reports/** 曾被静默吞掉）。
/reports/

# tools/eco-report 的运行产物与中间缓存（源码在 tools/eco-report/）
tools/eco-report/dashboard.html
tools/eco-report/full-ranking.*
tools/eco-report/tags-summary.json
tools/eco-report/scoring-diff.json
tools/eco-report/npm-search-cache.json
tools/eco-report/npm-map-expand-report.json
tools/eco-report/enrichment-candidates*.json
tools/eco-report/generic-repos.json
tools/eco-report/pilot-readme-cache.json
tools/eco-report/npm-keywords-cache.json
tools/eco-report/wechat*.png
tools/eco-report/potential-v4.json
tools/eco-report/npm-search-cache*.json
tools/eco-report/wechat-*.png

# Eco demand-analysis reports must be tracked (override the reports/ rule above)
!data/reports/
!data/reports/**

